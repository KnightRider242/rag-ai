# Copy this file to .env and replace the local development password.
APP_ENV=development
ENABLE_DOCUMENT_PARSE_ENDPOINT=false
POSTGRES_DB=rag_ai
POSTGRES_USER=rag_ai
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=500
MAX_EXTRACTED_CHARACTERS=2000000
DATABASE_URL=postgresql://rag_ai:change-me-for-local-development@localhost:5432/rag_ai
