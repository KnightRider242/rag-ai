# Copy this file to .env and replace the local development password.
APP_ENV=development
ENABLE_DOCUMENT_PARSE_ENDPOINT=false
ENABLE_DOCUMENT_INDEX_ENDPOINT=false
ENABLE_DOCUMENT_RETRIEVAL_ENDPOINT=false
POSTGRES_DB=rag_ai
POSTGRES_USER=rag_ai
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=500
MAX_EXTRACTED_CHARACTERS=2000000
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_CHUNKS_PER_DOCUMENT=5000
MAX_INDEX_CHUNKS_PER_DOCUMENT=500
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma:300m
MAX_EMBEDDING_DIMENSIONS=4096
MAX_EMBEDDING_ELEMENTS=1000000
DATABASE_URL=postgresql://rag_ai:change-me-for-local-development@localhost:5432/rag_ai
# APP_NAME=RAG-AI API
